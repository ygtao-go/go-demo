{
    "swagger": "2.0",
    "info": {
        "description": "go-admin 后台管理系统 API（Go + Gin + GORM + Redis + JWT），内置 AI 代码助手模块。\n统一响应信封：{\"code\": \u003cint\u003e, \"msg\": \u003cstring\u003e, \"data\": \u003cany|null\u003e}；code=0 表示成功（AI 模块为 200）。\n需鉴权接口请在 Authorize 中填写：Bearer \u003caccessToken\u003e。",
        "title": "go-admin API",
        "contact": {
            "name": "go-admin",
            "url": "http://localhost:8080"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/ai/explain": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "解释给定代码的含义与逻辑（业务码固定 200）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "AI 解释代码",
                "parameters": [
                    {
                        "description": "解释代码请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.CodeReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "解释成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.AIResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "AI 服务异常",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/ai/fix": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "修复给定代码中的错误（业务码固定 200）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "AI 修复代码",
                "parameters": [
                    {
                        "description": "修复代码请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.CodeReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "修复成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.AIResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "AI 服务异常",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/ai/generate": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据需求描述生成代码（业务码固定 200，兼容 web 前端判断）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "AI 生成代码",
                "parameters": [
                    {
                        "description": "生成代码请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.GenerateCodeReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "生成成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.AIResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "AI 服务异常",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/ai/generate/stream": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "AI SSE Streaming API：根据需求描述流式生成代码；SSE 事件格式为 data: {\"content\":\"<chunk>\"}，每次输出后立即 Flush，流结束发送 data: [DONE]",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "AI 生成代码（SSE 流式输出）",
                "parameters": [
                    {
                        "description": "生成代码请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.GenerateCodeReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSE 流（text/event-stream）"
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "AI 服务异常",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/ai/optimize": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "优化给定代码，使其更简洁高效（业务码固定 200）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "AI 优化代码",
                "parameters": [
                    {
                        "description": "优化代码请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.CodeReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "优化成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.AIResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "AI 服务异常",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/dashboard/statistics": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "返回用户总数、AI 调用/失败次数、HTTP 请求/错误次数；用户数来自 MySQL users 表，业务计数来自 Redis dashboard:* 计数器",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dashboard"
                ],
                "summary": "获取 Dashboard 统计数据",
                "responses": {
                    "200": {
                        "description": "统计成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.DashboardResult"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "统计数据获取失败",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "分页查询用户列表（page ≤0 时按 1；pageSize ≤0 或 \u003e100 时按 10）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "用户列表",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "页码（默认 1）",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每页条数（默认 10，最大 100）",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "用户列表",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.UserListResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "查询失败",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/info": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "返回当前登录用户详情（password 字段不会出现在任何响应中）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "获取用户信息",
                "responses": {
                    "200": {
                        "description": "用户信息",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.UserResult"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "404": {
                        "description": "用户不存在",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/login": {
            "post": {
                "description": "登录成功返回双 Token（accessToken 15 分钟有效，refreshToken 7 天有效）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "用户登录",
                "parameters": [
                    {
                        "description": "登录请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.LoginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "登录成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.TokenResult"
                        }
                    },
                    "400": {
                        "description": "参数错误或用户名/密码错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "撤销 accessToken（JTI 黑名单，TTL=剩余有效期）与 refreshToken（双向索引删除 + 7 天黑名单）；accessToken 从请求头获取",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "退出登录",
                "parameters": [
                    {
                        "description": "退出请求（refreshToken 必填）",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.LogoutReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "退出成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.StringResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "退出失败",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/password": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "校验旧密码后更新为新密码，成功后删除用户缓存（需登录）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "修改密码",
                "parameters": [
                    {
                        "description": "修改密码请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.UpdatePasswordReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "修改成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.StringResult"
                        }
                    },
                    "400": {
                        "description": "参数错误或旧密码错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/refresh": {
            "post": {
                "description": "使用 refreshToken 换取全新的双 Token；旧 refreshToken 原子消费作废，并发刷新同一 refreshToken 仅一个成功",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "刷新 Token",
                "parameters": [
                    {
                        "description": "刷新请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.RefreshReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "刷新成功（返回全新双 Token）",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.TokenResult"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "refresh token 无效、已过期或已被消费",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/register": {
            "post": {
                "description": "注册新用户（用户名 2~20 位，密码 6~20 位），成功后清除该用户名的\"不存在\"缓存",
