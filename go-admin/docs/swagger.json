                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "删除用户数据 + 用户缓存 + 该用户全部 refresh token 索引（需登录）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "删除用户",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "用户 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.StringResult"
                        }
                    },
                    "400": {
                        "description": "参数错误或用户不存在",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "500": {
                        "description": "删除失败",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        },
        "/user/{id}/status": {
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "切换用户状态：1=正常，2=禁用（其它值返回 400）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户"
                ],
                "summary": "切换用户状态",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "用户 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "状态切换请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.SwitchStatusReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "状态更新成功",
                        "schema": {
                            "$ref": "#/definitions/go-admin_internal_dto.StringResult"
                        }
                    },
                    "400": {
                        "description": "参数错误或状态值无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    },
                    "401": {
                        "description": "未登录或 token 无效",
                        "schema": {
                            "$ref": "#/definitions/go-admin_pkg_response.Result"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "go-admin_internal_dto.AIResult": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "业务码：200=成功",
                    "type": "integer"
                },
                "data": {
                    "description": "AI 返回文本（生成的代码 / 解释 / 修复 / 优化结果）",
                    "type": "string"
                },
                "msg": {
                    "description": "提示信息",
                    "type": "string"
                }
